{
  "manifest_version": 2,
  "name": "Metadata Fixer",
  "version": "0.1.5",
  "description": "Upgrade preprints in place, fill missing metadata and fix clear errors while preserving your edits.",
  "author": "Zhi Lu",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "applications": {
    "zotero": {
      "id": "metadata-linter@lzcn",
      "strict_min_version": "10.0",
      "strict_max_version": "10.*",
      "update_url": "https://github.com/lzcn/zotero-metadata-linter/releases/latest/download/updates.json"
    }
  }
}
